# Copy to .env and set your own values before starting the container.
AUTH_USERNAME=changeme
AUTH_PASSWORD=change-this-to-a-long-passphrase
SESSION_DAYS=30

# --- AI tutor (optional) ---
# Supply ONE of these. The service auto-detects which provider to use.
GEMINI_API_KEY=
OPENAI_API_KEY=
# Override the model if the default is not available on your account:
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4o
